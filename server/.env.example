# SafeHer Server Environment Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=safeher_super_secure_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Database (Leave empty or set to test MongoDB Atlas URL)
# If MONGO_URI is omitted or cannot connect, the server automatically uses local development JSON storage fallback
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/safeher?retryWrites=true&w=majority

# CORS Configuration (comma-separated origins allowed in production)
CLIENT_ORIGIN=http://localhost:5173

# Notification Provider Mode: "demo" (default) or "production"
# In demo mode, alerts are realistically logged and dispatch payloads are prepared with simulated provider receipts
NOTIFICATION_MODE=demo

# Twilio SMS / WhatsApp (Optional - only required if NOTIFICATION_MODE=production)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890
